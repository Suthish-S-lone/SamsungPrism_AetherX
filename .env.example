# ==============================================================================
# SmartGuide Prototype - Environment Configuration Example
# (DO NOT commit secrets or actual API keys to source control)
# ==============================================================================

# Application Environment
APP_NAME="SmartGuide Troubleshooting Engine"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"
PORT=8000
HOST="0.0.0.0"

# Future LLM Provider Configuration (Phase 3+)
# Options: "gemini", "openai", "local", "mock"
LLM_PROVIDER="gemini"
LLM_API_KEY="your-llm-api-key-here"
LLM_MODEL="gemini-1.5-flash"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Future Embedding Configuration (Phase 2+)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Future Retrieval & Cache Configuration (Phase 2+)
SIMILARITY_THRESHOLD=0.75
CACHE_BACKEND="memory"  # memory, redis
CACHE_TTL_SECONDS=3600
CACHE_SIMILARITY_THRESHOLD=0.92

# Data Paths
DATA_DIR="data/development"
