# ==============================================================================
# SmartGuide Prototype — .gitignore
# ==============================================================================

# Python Bytecode & Compilation
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Testing, Coverage & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
*.tmp
*.temp
*.bak
*.out.txt
eval_*.txt

# Machine Learning / Model & Embedding Caches (Models are downloaded/cached locally)
.cache/
hf_cache/
models_cache/
*.safetensors

# Local Agent / Development Artifacts
.antigravity/
.gemini/
